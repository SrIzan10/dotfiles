binds {

    // ────────────── Keybindings (modelled on Omarchy defaults) ──────────────
    // https://github.com/YaLTeR/niri/wiki/Configuration:-Key-Bindings
    // https://docs.noctalia.dev/getting-started/keybinds/

    Mod+Shift+Slash                     hotkey-overlay-title="Show Keybindings" { show-hotkey-overlay; }

    // ─── Applications ───
    Mod+Return                          hotkey-overlay-title="Terminal: Foot" { spawn "/home/srizan/.config/niri/foot-last-cwd.sh"; }
    Mod+Shift+F                         hotkey-overlay-title="File Manager (default)" { spawn-sh "gtk-launch $(xdg-mime query default inode/directory)"; }
    Mod+Shift+B                         hotkey-overlay-title="Browser (default)" { spawn-sh "gtk-launch $(xdg-settings get default-web-browser)"; }

    // ─── Noctalia (launcher / menus) ───
    Mod+Space                           hotkey-overlay-title="App Launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+Alt+Space                       hotkey-overlay-title="Control Center" { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Escape                          hotkey-overlay-title="Session Menu" { spawn-sh "noctalia msg panel-toggle session"; }
    Mod+Ctrl+E                          hotkey-overlay-title="Emoji Picker" { spawn-sh "noctalia msg panel-toggle launcher /emo"; }
    Mod+Ctrl+Space                      hotkey-overlay-title="Wallpaper Selector" { spawn-sh "noctalia msg panel-toggle wallpaper"; }
    Mod+Ctrl+Shift+Space                hotkey-overlay-title="Noctalia Settings" { spawn-sh "noctalia msg settings-toggle"; }
    Mod+Shift+Space                     hotkey-overlay-title="Toggle Bar" { spawn-sh "noctalia msg bar-toggle"; }

    // Copilot key (sends Super+Shift+F23): fzf a directory, open Claude Code there
    Mod+Shift+F23                       hotkey-overlay-title="Claude Code in Directory" { spawn "foot" "/home/srizan/.config/niri/claude-fzf-dir.sh"; }

    // ─── Toggles ───
    Mod+Ctrl+N                          hotkey-overlay-title="Toggle Night Light" { spawn-sh "noctalia msg nightlight-force-toggle"; }
    Mod+Ctrl+I                          hotkey-overlay-title="Toggle Idle Inhibitor" { spawn-sh "noctalia msg caffeine-toggle"; }
    Mod+Ctrl+L                          hotkey-overlay-title="Lock Screen" { spawn-sh "noctalia msg session lock"; }

    // ─── Media Controls ───
    XF86AudioRaiseVolume                allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume                allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute                       allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute                    allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86AudioNext                       allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev                       allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
    XF86AudioPlay                       allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPause                      allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }

    // ─── Brightness Controls ───
    XF86MonBrightnessUp                 allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown               allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    // ─── Window Management ───
    Mod+W                               { close-window; }
    Mod+T                               { toggle-window-floating; }
    Mod+F                               { fullscreen-window; }
    Mod+Ctrl+F                          { maximize-window-to-edges; }
    Mod+Alt+F                           { maximize-column; }
    Mod+G                               { toggle-column-tabbed-display; }
    Mod+R                               { switch-preset-column-width; }
    Mod+Shift+R                         { switch-preset-column-width-back; }
    Mod+O                               repeat=false { toggle-overview; }
    Mod+Alt+C                           { center-column; }
    Mod+Shift+V                         { switch-focus-between-floating-and-tiling; }

    // Move focus with Mod + arrow keys
    Mod+Left                            { focus-column-left; }
    Mod+Right                           { focus-column-right; }
    Mod+Up                              { focus-window-up; }
    Mod+Down                            { focus-window-down; }
    Mod+H                               { focus-column-left; }
    Mod+L                               { focus-column-right; }
    Mod+K                               { focus-window-up; }
    Mod+J                               { focus-window-down; }

    // Swap windows with Mod + Shift + arrow keys
    Mod+Shift+Left                      { move-column-left; }
    Mod+Shift+Right                     { move-column-right; }
    Mod+Shift+Up                        { move-window-up; }
    Mod+Shift+Down                      { move-window-down; }
    Mod+Shift+H                         { move-column-left; }
    Mod+Shift+L                         { move-column-right; }
    Mod+Shift+K                         { move-window-up; }
    Mod+Shift+J                         { move-window-down; }

    // Stack / unstack windows in a column
    Mod+BracketLeft                     { consume-or-expel-window-left; }
    Mod+BracketRight                    { consume-or-expel-window-right; }

    // Resize active window
    Mod+Minus                           { set-column-width "-10%"; }
    Mod+Equal                           { set-column-width "+10%"; }
    Mod+Shift+Minus                     { set-window-height "-10%"; }
    Mod+Shift+Equal                     { set-window-height "+10%"; }

    // ─── Monitors ───
    Mod+Ctrl+Left                       { focus-monitor-left; }
    Mod+Ctrl+Right                      { focus-monitor-right; }
    Mod+Shift+Alt+Left                  { move-workspace-to-monitor-left; }
    Mod+Shift+Alt+Right                 { move-workspace-to-monitor-right; }

    // ─── Workspaces ───
    Mod+1                               { focus-workspace 1; }
    Mod+2                               { focus-workspace 2; }
    Mod+3                               { focus-workspace 3; }
    Mod+4                               { focus-workspace 4; }
    Mod+5                               { focus-workspace 5; }
    Mod+6                               { focus-workspace 6; }
    Mod+7                               { focus-workspace 7; }
    Mod+8                               { focus-workspace 8; }
    Mod+9                               { focus-workspace 9; }
    Mod+0                               { focus-workspace 10; }

    Mod+Shift+1                         { move-column-to-workspace 1; }
    Mod+Shift+2                         { move-column-to-workspace 2; }
    Mod+Shift+3                         { move-column-to-workspace 3; }
    Mod+Shift+4                         { move-column-to-workspace 4; }
    Mod+Shift+5                         { move-column-to-workspace 5; }
    Mod+Shift+6                         { move-column-to-workspace 6; }
    Mod+Shift+7                         { move-column-to-workspace 7; }
    Mod+Shift+8                         { move-column-to-workspace 8; }
    Mod+Shift+9                         { move-column-to-workspace 9; }
    Mod+Shift+0                         { move-column-to-workspace 10; }

    Mod+Tab                             { focus-workspace-down; }
    Mod+Shift+Tab                       { focus-workspace-up; }
    Mod+Ctrl+Tab                        { focus-workspace-previous; }

    // Scroll through workspaces with Mod + mouse wheel
    Mod+WheelScrollDown                 cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp                   cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown           { focus-column-right; }
    Mod+Shift+WheelScrollUp             { focus-column-left; }

    // ─── Screenshots ───
    // Screenshot key on this keyboard sends Super+Shift+S
    Mod+Shift+S                         hotkey-overlay-title="Screenshot" { screenshot; }
    Print                               { screenshot; }
    Shift+Print                         { screenshot-screen; }
    Ctrl+Print                          { screenshot-window; }

    // ─── Emergency Escape Key ───
    // Use this when a fullscreen app blocks your keybinds.
    Mod+Ctrl+Escape                     allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // ─── Exit / Power ───
    Ctrl+Alt+Delete                     { quit; }
    Mod+Shift+P                         { power-off-monitors; }
}
