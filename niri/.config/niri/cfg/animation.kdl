    // Short, linear-feeling animations: no springs, no bounce
    animations {
        workspace-switch {
            duration-ms 120
            curve "ease-out-cubic"
        }
        window-open {
            duration-ms 100
            curve "ease-out-cubic"
        }
        window-close {
            duration-ms 100
            curve "ease-out-cubic"
        }
        horizontal-view-movement {
            duration-ms 120
            curve "ease-out-cubic"
        }
        window-movement {
            duration-ms 120
            curve "ease-out-cubic"
        }
        window-resize {
            duration-ms 120
            curve "ease-out-cubic"
        }
        config-notification-open-close {
            duration-ms 150
            curve "ease-out-cubic"
        }
        screenshot-ui-open {
            duration-ms 150
            curve "ease-out-quad"
        }
        overview-open-close {
            duration-ms 150
            curve "ease-out-cubic"
        }
    }
